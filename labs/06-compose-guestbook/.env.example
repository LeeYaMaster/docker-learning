# 复制本文件为 .env 后再启动：
#   cp .env.example .env
#
# 以下账号密码仅供本机学习使用，不要用于生产，也不要提交到公开仓库。

MYSQL_ROOT_PASSWORD=learn_root_pass
MYSQL_DATABASE=guestbook
MYSQL_USER=guestbook
MYSQL_PASSWORD=learn_pass

# Flask 会话签名。学习环境用固定值即可。
SECRET_KEY=dev-only-not-for-production

# 说明：Web 容器里连数据库 / Redis 时，主机名是 Compose 服务名 db 和 redis，
# 端口是容器内端口 3306 / 6379（见 docker-compose.yml）。
# 你在 Mac 上用客户端连接时，才使用映射后的 127.0.0.1:3307 和 127.0.0.1:6380。
